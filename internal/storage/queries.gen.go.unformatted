// GetGear - Gear queries.
const getGearSQL = `SELECT
    g.id,
    g.name,
    g.is_primary,
    g.retired,
    g.distance,
    g.brand_name,
    g.model_name,
    g.description,
    g.source,
    g.hashtag,
    g.purchase_price,
    g.purchase_currency,
    (SELECT COUNT(*) FROM activities WHERE gear_id = g.id) AS activity_count
FROM gear g
WHERE g.athlete_id = ?1
ORDER BY g.name;`

// GetGear executes the query and returns all rows.
