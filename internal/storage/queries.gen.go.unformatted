		return nil, err
	}
	return items, nil
}


// ============================================================================
// GetAllDailyTSS
// ============================================================================

// GetAllDailyTSSRow represents a row returned by GetAllDailyTSS.
type GetAllDailyTSSRow struct {
	Day string `json:"day"`
	TSS string `json:"tss"`
}

const getAllDailyTSSSQL = `SELECT day, tss
FROM v_daily_tss
WHERE athlete_id = ?1
ORDER BY day ASC;`

// GetAllDailyTSS executes the query and returns all rows.
func (q *Queries) GetAllDailyTSS(ctx context.Context, athleteID int64) ([]GetAllDailyTSSRow, error) {
	rows, err := q.db.QueryContext(ctx, getAllDailyTSSSQL, athleteID)
	if err != nil {
		return nil, err
	}
	defer func() { _ = rows.Close() }()

	var items []GetAllDailyTSSRow
	for rows.Next() {
		var i GetAllDailyTSSRow
		if err := rows.Scan(&i.Day, &i.TSS); err != nil {
			return nil, err
		}
		items = append(items, i)
	}
	if err := rows.Err(); err != nil {
		return nil, err
	}
	return items, nil
}


// ============================================================================
// GetActivityTSS
// ============================================================================

// GetActivityTSSRow represents a row returned by GetActivityTSS.
type GetActivityTSSRow struct {
	TSS string `json:"tss"`
	NormalizedPower string `json:"normalized_power"`
	IntensityFactor string `json:"intensity_factor"`
}

const getActivityTSSSQL = `SELECT tss, normalized_power, intensity_factor
FROM activity_training_load
WHERE activity_id = ?1;`

// GetActivityTSS executes the query and returns a single row, or nil if not found.
func (q *Queries) GetActivityTSS(ctx context.Context, activityID int64) (*GetActivityTSSRow, error) {
	row := q.db.QueryRowContext(ctx, getActivityTSSSQL, activityID)
	var i GetActivityTSSRow
	err := row.Scan(&i.TSS, &i.NormalizedPower, &i.IntensityFactor)
	if err != nil {
		if err == sql.ErrNoRows {
			return nil, nil
		}
		return nil, err
	}
	return &i, nil
}


