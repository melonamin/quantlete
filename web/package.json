{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:wasm": "vite --mode wasm",
    "build": "tsc -b && vite build",
    "build:server": "tsc -b && vite build --mode server",
    "build:wasm": "tsc -b && vite build --mode wasm",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "vite preview",
    "preview:wasm": "vite preview --mode wasm",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prettier": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "prettier:write": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test:unit": "vitest run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
