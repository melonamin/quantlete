# WASM Mode Environment Variables
# Copy this to .env.wasm and fill in the values

# Build mode - must be "wasm" for browser-only mode
VITE_BUILD_MODE=wasm

# Cloudflare Worker URL for OAuth token exchange
# The worker acts as a stateless CORS proxy - no secrets stored on the worker.
# Each user configures their own Strava credentials in the browser.
VITE_CF_WORKER_URL=https://stata-strava-proxy.your-account.workers.dev
